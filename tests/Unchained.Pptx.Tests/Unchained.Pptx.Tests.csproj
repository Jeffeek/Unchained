  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unchained.Pptx\Unchained.Pptx.csproj" />
    <ProjectReference Include="..\..\src\Unchained.Drawing\Unchained.Drawing.csproj" />
