<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unchained.Xlsx\Unchained.Xlsx.csproj" />
  </ItemGroup>

  <!-- Real XLSX test files: copied to output so tests can load from AppContext.BaseDirectory. -->
  <ItemGroup>
    <Content Include="TestFiles\**\*.xlsx"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('TestFiles\')" />
  </ItemGroup>

</Project>
